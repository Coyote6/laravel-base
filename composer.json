{
    "name": "coyote6/laravel-base",
    "type": "library",
    "description": "Provides common base classes used for some of Coyote6 GraphX's developed projects.  Provides UUID trait for models using it as a primary key.  Provides trait methods to return models as options.",
    "keywords": ["laravel","traits"],
    "homepage": "https://coyote6.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tanner Naeher",
            "email": "tanner@coyote6.com",
            "homepage": "https://coyote6.com",
            "role": "Developer"
        }
    ],
    "require": {
        "coyote6/laravel-str": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Coyote6\\LaravelBase\\": "src/"
        },
        "files": [
	        "src/Helpers/Helpers.php"
	    ]
    },
    "autoload-dev": {
        "psr-4": {
            "Coyote6\\LaravelBase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coyote6\\LaravelBase\\Providers\\BaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}