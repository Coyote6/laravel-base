{
    "name": "coyote6/laravel-base",
    "type": "library",
    "description": "Small Laravel traits and helpers for Eloquent model creation-time conventions (author/client/machine name/slug stamping), select-option helpers, and a couple of database/file utilities.",
    "keywords": ["laravel","traits"],
    "homepage": "https://coyote6.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tanner Naeher",
            "email": "tanner@coyote6.com",
            "homepage": "https://coyote6.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "coyote6/laravel-str": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Coyote6\\LaravelBase\\": "src/"
        },
        "files": [
	        "src/Helpers/Helpers.php"
	    ]
    },
    "autoload-dev": {
        "psr-4": {
            "Coyote6\\LaravelBase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coyote6\\LaravelBase\\Providers\\BaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}